# Secrets — never committed
.env
.env.*
!.env.example

# The toolkit is its own repo, cloned into .claude/. The project never tracks
# it — not its files, and not as a gitlink. Ignoring only .claude/.git/ is not
# enough: git still sees the nested repo and records a phantom submodule
# pointer that nothing can resolve.
.claude/

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Poetry — lock file IS committed; only local config is ignored
poetry.toml

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# JWT signing keys — never committed
keys/
*.pem

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and local scratch
*.log
logs/
scratch/
tmp/

# Alembic — versions ARE committed. Nothing here is ignored by default.
# Do not add alembic/versions/ to this file.
