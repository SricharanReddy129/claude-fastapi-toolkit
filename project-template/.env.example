# .env.example — the committed configuration contract.
#
# Every key the settings class reads MUST appear here with a placeholder.
# Real values go in .env, which is gitignored and never read by Claude.
#
# Adding a setting? Add it here in the same change, or the parity check fails.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=<project-name>
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async driver for the app (asyncpg / psycopg async).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/<db-name>

# Sync driver for Alembic. Same database, different driver — this is expected.
ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/<db-name>

# Tests run against the same database, isolated by transaction rollback.
# Nothing a test creates is ever committed.

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth — tokens
# ---------------------------------------------------------------------------
# Identifies this platform. Tokens from another platform must not validate here.
JWT_ISSUER=https://<platform>.example.com
JWT_AUDIENCE=<platform>-api

# Exactly one algorithm is accepted. Never read `alg` from the token header.
JWT_ALGORITHM=RS256

ACCESS_TOKEN_TTL_MINUTES=15
IDENTITY_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_DAYS=30

# Window where a just-rotated refresh token is still accepted, so concurrent
# refreshes (multiple tabs) do not trip reuse detection.
REFRESH_GRACE_SECONDS=10

JWT_CLOCK_SKEW_SECONDS=30

# ---------------------------------------------------------------------------
# Auth — keys
# ---------------------------------------------------------------------------
# Private key for signing. Never commit a real value.
JWT_PRIVATE_KEY_PATH=<path-or-secret-ref>
JWT_ACTIVE_KID=<key-id>

# ---------------------------------------------------------------------------
# Auth — cookies and CSRF (cross-origin frontend)
# ---------------------------------------------------------------------------
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none     # cross-origin — CSRF check is mandatory
CSRF_SECRET=<random-value>

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Explicit allowlist. Never "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Passwords
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=100
CURSOR_SIGNING_SECRET=<random-value>

# ---------------------------------------------------------------------------
# Adapters
# ---------------------------------------------------------------------------
# Third-party credentials. Placeholders only.
# <SERVICE>_API_KEY=<placeholder>
# <SERVICE>_BASE_URL=<placeholder>
# <SERVICE>_TIMEOUT_SECONDS=10
